{
  "name": "VJ Tam Tam",
  "short_name": "Tam Tam",
  "description": "A local-first auto VJ tool for fullscreen visual playback from your own photos, videos, and text.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "background_color": "#050607",
  "theme_color": "#050607",
  "orientation": "any",
  "icons": [
    {
      "src": "assets/img/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "assets/img/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "assets/img/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
